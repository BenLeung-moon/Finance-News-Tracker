# LLM provider selection (fallback for both roles when role-specific vars are empty)
LLM_PROVIDER=deepseek

# Role-specific LLM defaults (optional; empty = fall back to LLM_PROVIDER + provider model)
# Scoring = high-throughput relevance filter
# Analysis = Entity / Impact / Suggested Action + Weekly Memo synthesis
SCORING_LLM_PROVIDER=
SCORING_LLM_MODEL=
ANALYSIS_LLM_PROVIDER=
ANALYSIS_LLM_MODEL=

# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Tracker profile (built-in: usdjpy). Add custom profiles under profiles/.
TRACKER_PROFILE=usdjpy

# Tracker settings
DATA_DIR=data
SUMMARIES_DIR=summaries
LOG_DIR=logs
# Optional global override. Empty uses the active profile default
# (usdjpy = 72 hours).
RECENCY_HOURS=
MIN_RELEVANCE_SCORE=40
MAX_ARTICLES_TO_SCORE=25
FX_MEDIA_SCORE_LIMIT_PER_SOURCE=3
FX_MEDIA_SCORE_LIMIT_COMBINED=5
# Neutral aliases (preferred for new deployments):
# NOISY_SCORE_LIMIT_PER_SOURCE=3
# NOISY_SCORE_LIMIT_COMBINED=5
DEDUPE_SIMILARITY_THRESHOLD=0.82
SUMMARY_MAX_PER_SOURCE=2
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=FinanceNewsTracker/0.1 (local research; +https://github.com)

# Scheduling (used by run-scheduled; cron should also use CRON_TZ=Asia/Hong_Kong)
RUN_TIMEZONE=Asia/Hong_Kong
RUN_WEEKDAYS_ONLY=true
HOLIDAY_GUARD_ENABLED=false
REPORT_RETENTION_DAYS=90
LOG_LEVEL=INFO

# Email delivery (adapter layer; run-once does not send email)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your.name@nexaracapital.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=your.name@nexaracapital.com
EMAIL_TO=your.name@nexaracapital.com,recipient2@nexaracapital.com
EMAIL_SUBJECT_PREFIX=[TEST] Finance News Tracker
EMAIL_ATTACH_DOCX=true
