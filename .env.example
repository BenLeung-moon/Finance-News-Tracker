# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Tracker settings
DATA_DIR=data
RECENCY_HOURS=72
MIN_RELEVANCE_SCORE=40
MAX_ARTICLES_TO_SCORE=25
SUMMARY_CANDIDATE_POOL_LIMIT=50
SUMMARY_MAX_STORIES=7
SUMMARY_MAX_CITATIONS=15
CHECKER_OFFICIAL_MIN=2
CHECKER_INTL_MEDIA_MAX_STORIES=2
CHECKER_LOCAL_MEDIA_MAX_STORIES=3
CHECKER_INTL_MEDIA_MAX_CITATIONS=3
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=FinanceNewsTracker/0.1 (local research; +https://github.com)
